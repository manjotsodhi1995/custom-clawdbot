# AI Provider (required - choose one)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Telegram (optional)
TELEGRAM_BOT_TOKEN=

# Slack (optional - both required if using Slack)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Signal (optional)
SIGNAL_ACCOUNT=

# Gateway Configuration
GATEWAY_PORT=18789
GATEWAY_BIND=loopback

# Node Environment
NODE_ENV=production

# Optional: Custom home directory
# CLAWDBOT_HOME=$HOME/.clawdbot
