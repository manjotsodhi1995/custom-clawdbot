# ClawdBot Docker Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# CORE SETTINGS
# =============================================================================

# Node environment (production, development)
NODE_ENV=production

# Docker image name
CLAWDBOT_IMAGE=clawdbot:latest

# =============================================================================
# GATEWAY CONFIGURATION
# =============================================================================

# Gateway bind address (lan, loopback, or specific IP)
# Use 'lan' for Docker to allow external connections
OPENCLAW_GATEWAY_BIND=lan

# Gateway port (default: 18789)
OPENCLAW_GATEWAY_PORT=18789

# Gateway authentication token (optional, recommended for security)
# Generate with: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=

# Gateway host binding for port mapping (127.0.0.1 for localhost only)
GATEWAY_HOST=127.0.0.1

# =============================================================================
# TELEGRAM CONFIGURATION
# =============================================================================

# Telegram Bot Token from @BotFather
# Example: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_TOKEN=

# =============================================================================
# SLACK CONFIGURATION
# =============================================================================

# Slack Bot Token (starts with xoxb-)
# Get from: https://api.slack.com/apps -> OAuth & Permissions
SLACK_BOT_TOKEN=

# Slack App Token (starts with xapp-)
# Get from: https://api.slack.com/apps -> Basic Information -> App-Level Tokens
SLACK_APP_TOKEN=

# =============================================================================
# SIGNAL CONFIGURATION
# =============================================================================

# Signal phone number in E.164 format (e.g., +15551234567)
# This is the phone number that will be registered with signal-cli
SIGNAL_PHONE_NUMBER=

# Signal-cli version to install
SIGNAL_CLI_VERSION=0.13.9

# =============================================================================
# DISCORD CONFIGURATION (Optional)
# =============================================================================

# Discord Bot Token
# Get from: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# =============================================================================
# AI MODEL CONFIGURATION
# =============================================================================

# Anthropic API Key (for Claude models)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI API Key (for GPT models)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# =============================================================================
# REMOTE CODE WEBHOOK (Optional)
# =============================================================================

# Remote code API URL (if using remote code execution)
REMOTE_CODE_API_URL=

# ClawdBot API Key for webhook authentication
CLAWDBOT_API_KEY=

# =============================================================================
# DATA DIRECTORIES
# =============================================================================

# Main config directory (where clawdbot.json is stored)
CLAWDBOT_CONFIG_DIR=./clawdbot-data

# Workspace directory (for agent files and skills)
CLAWDBOT_WORKSPACE_DIR=./clawdbot-data/workspace

# Signal-cli data directory (for Signal account data)
SIGNAL_CLI_DATA_DIR=./signal-cli-data

# Telegram session data directory
TELEGRAM_DATA_DIR=./telegram-data

# =============================================================================
# OPTIONAL SETTINGS
# =============================================================================

# GOG keyring password (if needed)
GOG_KEYRING_PASSWORD=

# =============================================================================
# NOTES
# =============================================================================

# 1. TELEGRAM SETUP:
#    - Create a bot with @BotFather on Telegram
#    - Copy the bot token to TELEGRAM_BOT_TOKEN
#    - Configure allowFrom in clawdbot.json for access control

# 2. SLACK SETUP:
#    - Create a Slack app at https://api.slack.com/apps
#    - Enable Socket Mode and generate an App-Level Token
#    - Install the app to your workspace and copy the Bot Token
#    - Add required scopes (see docs/channels/slack.md)

# 3. SIGNAL SETUP:
#    - Set SIGNAL_PHONE_NUMBER to your bot's phone number
#    - After starting the container, register the number:
#      docker exec -it clawdbot-gateway signal-cli -a +15551234567 register
#    - Follow the verification process (see docs/channels/signal-cli-registration.md)

# 4. SECURITY:
#    - Keep this file secure and never commit it to version control
#    - Use strong, unique tokens for all services
#    - Consider using Docker secrets for production deployments
#    - Bind gateway to 127.0.0.1 (localhost) unless you need external access

# 5. DATA PERSISTENCE:
#    - All data directories are mounted as volumes
#    - Back up these directories regularly
#    - Use named volumes in production for better management

# 6. GETTING STARTED:
#    - Copy this file: cp .env.example .env
#    - Fill in your tokens and configuration
#    - Run: docker-compose up -d
#    - Check logs: docker-compose logs -f
#    - Access gateway: http://localhost:18789
